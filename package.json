{
  "name": "ts-ucan",
  "description": "TypeScript implementation of UCANs",
  "author": "Mark Tripoli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarkTripoli/ts-ucan.git"
  },
  "homepage": "https://github.com/MarkTripoli/ts-ucan",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p packages/varsig && tsc -p packages/ucan",
    "test": "npm --workspace=@marktripoli/varsig test && npm --workspace=@marktripoli/ucan test",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "eslint ."
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@noble/hashes": "^1.8.0",
    "eslint": "^10.9.1",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/MarkTripoli/ts-ucan/issues"
  }
}
