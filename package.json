{
  "name": "ucans",
  "description": "TypeScript implementation of UCANs",
  "author": "Daniel Holmgren <daniel@fission.codes>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ucan-wg/ts-ucan"
  },
  "homepage": "https://guide.fission.codes",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p packages/varsig && tsc -p packages/ucan",
    "test": "npm --workspace=@ucans/varsig test && npm --workspace=@ucans/ucan test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@noble/hashes": "^1.8.0",
    "typescript": "^5",
    "vitest": "^3"
  },
  "type": "module"
}