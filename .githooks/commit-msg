#!/bin/sh
# Enforce Conventional Commits: type(scope)!: subject
msg="$(head -1 "$1")"
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9./-]+\))?!?: .{1,72}$'
if ! printf '%s' "$msg" | grep -qE "$pattern"; then
  echo "commit-msg: not a semantic commit:" >&2
  echo "  $msg" >&2
  echo "expected: type(scope)?: subject  (types: feat fix docs style refactor perf test build ci chore revert)" >&2
  exit 1
fi
